# SQLite database file used by Prisma
DATABASE_URL="file:./dev.db"

# OpenRouter (https://openrouter.ai) API key used for all AI calls
# (transaction parsing + the financial chat assistant)
OPENROUTER_API_KEY=

# Optional: override the default OpenRouter model used for AI calls
# See https://openrouter.ai/models for available options
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Secret used to sign session + OTP JWTs. Generate a long random value, e.g.:
#   openssl rand -base64 48
AUTH_SECRET=

# SMS provider for sending real OTP codes (Kavenegar, Ghasedak, etc).
# Not wired up yet - until then OTP codes are printed to the server console.
SMS_PROVIDER_API_KEY=
