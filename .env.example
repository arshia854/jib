# Turso (libSQL) database used by Prisma. Get these with the Turso CLI:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
TURSO_AUTH_TOKEN=

# Nerkh (https://nerkh.io) - live gold(18k gram)/dollar/bitcoin prices in
# Toman, used by the Assets feature (lib/prices/get-live-prices.ts) for
# purchase-vs-current profit/loss and the optional "show balance in
# gold/dollar" dashboard toggle. Free/test plan available - request a token
# at https://nerkh.io/ (name/mobile/email form); tokens are only valid for
# 60 days, so this needs periodic renewal.
# Optional - without it, the Assets page still works for manually-priced
# ("custom") assets, but gold/usd/bitcoin holdings show no live price.
NERKH_API_KEY=

# NVIDIA NIM (https://build.nvidia.com) - OpenAI-compatible API used for all
# AI calls (transaction parsing + the financial chat assistant).
NVIDIA_API_KEY=
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.1-70b-instruct"

# OpenRouter (https://openrouter.ai) - OpenAI-compatible gateway.
# Not currently in use - kept around in case we switch back.
OPENROUTER_API_KEY=
OPENROUTER_MODEL="google/gemini-2.5-flash"

# ArvanCloud AIaaS (https://www.arvancloud.ir) - OpenAI-compatible gateway.
# Not currently in use - kept around in case we switch back.
# ARVAN_AI_BASE_URL is the full gateway URL for your deployed model,
# including the path token, ending in /v1 (no trailing /chat/completions).
ARVAN_AI_API_KEY=
ARVAN_AI_BASE_URL="https://arvancloudai.ir/gateway/models/DeepSeek-V4-Flash/<TOKEN_FROM_YOUR_URL>/v1"
ARVAN_AI_MODEL="DeepSeek-V4-Flash"

# Secret used ONLY for NextAuth's (Auth.js) own session JWTs - this exact
# variable name is NextAuth's convention, so don't rename it. Kept separate
# from OTP_SECRET/LEGACY_SESSION_SECRET below (each of the three used to
# read this same value) so a leak of one never forges the other two token
# types. Generate a long random value, e.g.:
#   openssl rand -base64 48
AUTH_SECRET=

# Secret used only to sign/verify the short-lived (120s) OTP challenge JWT
# (lib/auth/otp.ts) - kept independent from AUTH_SECRET/LEGACY_SESSION_SECRET
# so a leaked value can't be used to forge the other two. Generate the same
# way as AUTH_SECRET (a fresh random value, not derived from it):
#   openssl rand -base64 48
OTP_SECRET=

# Secret used only to sign/verify the pre-NextAuth legacy session cookie
# (lib/auth/session.ts) - still read for the shrinking pool of users who
# haven't re-authenticated since the NextAuth migration. Kept independent
# from AUTH_SECRET/OTP_SECRET for the same reason. Generate the same way
# (a fresh random value, not derived from either of the other two):
#   openssl rand -base64 48
LEGACY_SESSION_SECRET=

# Google OAuth ("ورود با گوگل"). Create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, type
# "Web application"). Authorized redirect URIs:
#   Local dev:   http://localhost:3000/api/auth/callback/google
#   Production:  https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Melipayamak (https://www.melipayamak.com) credentials for sending real OTP
# codes via their pattern-based SMS API. All three are optional - as long as
# any is unset, OTP codes are printed to the server console instead
# (`[mock SMS] OTP for 0912...: 123456`).
#   MELIPAYAMAK_USERNAME / MELIPAYAMAK_PASSWORD - your panel login
#   MELIPAYAMAK_BODY_ID  - the numeric id of a pre-approved OTP pattern
#                          ("الگو") registered in the Melipayamak panel
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_BODY_ID=

# Sentry (https://sentry.io) - error monitoring (Phase 12). Both optional:
# when unset, the SDK no-ops cleanly (see sentry.server.config.ts /
# instrumentation-client.ts) rather than throwing or blocking requests, so
# local dev works fine without a real Sentry project.
#   SENTRY_DSN              - server-side (API routes, instrumentation.ts).
#   NEXT_PUBLIC_SENTRY_DSN  - client-side (instrumentation-client.ts). Needs
#                             the NEXT_PUBLIC_ prefix to be readable in the
#                             browser bundle at all - usually the same DSN
#                             value as SENTRY_DSN above, just re-declared
#                             under the prefixed name Next.js requires for
#                             client-exposed env vars.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
