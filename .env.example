# SQLite database file used by Prisma
DATABASE_URL="file:./dev.db"

# OpenRouter (https://openrouter.ai) API key used for all AI calls
# (transaction parsing + the financial chat assistant)
OPENROUTER_API_KEY=

# Optional: override the default OpenRouter model used for AI calls
# See https://openrouter.ai/models for available options
OPENROUTER_MODEL="google/gemini-2.5-flash"
